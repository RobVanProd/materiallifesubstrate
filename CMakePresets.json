{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "MLS development (Ninja, Debug)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": "ON",
        "MLS_BUILD_TESTS": "ON",
        "MLS_AUDIT_DEFAULT": "ON",
        "MLS_WARNINGS_AS_ERRORS": "ON",
        "MLS_RUN_EXTENDED_EXACT_TESTS": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "MLS release (Ninja)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "ON",
        "MLS_BUILD_TESTS": "ON",
        "MLS_AUDIT_DEFAULT": "ON",
        "MLS_WARNINGS_AS_ERRORS": "ON",
        "MLS_RUN_EXTENDED_EXACT_TESTS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "configurePreset": "dev"
    },
    {
      "name": "release",
      "configurePreset": "release"
    }
  ],
  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
